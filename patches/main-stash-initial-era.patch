+
+// Patch cursor code to expose mx/my globally
+
+// ═══ TOUCH ADAPTATIONS ═══
+(function(){
+  var isTouch='ontouchstart' in window||navigator.maxTouchPoints>0;
+  if(!isTouch)return;
+
+  // ── Tap Ripple (cursor replacement) ──
+  document.addEventListener('touchstart',function(e){
+    var t=e.touches[0];
+    var r=document.createElement('div');
+    r.className='tap-ripple';
+    r.style.left=t.clientX+'px';
+    r.style.top=t.clientY+'px';
+    document.body.appendChild(r);
+    setTimeout(function(){r.remove()},400);
+  },{passive:true});
+
+  // ── Same Room: tap to activate cards ──
+  var srCards=document.querySelectorAll('.sr-card');
+  srCards.forEach(function(card,idx){
