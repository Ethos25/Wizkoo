+      card.classList.add('active');
+      // Update background color
+      var temps=['#0C0B08','#0E0C09','#0D0A0A','#0A0B0E'];
+      var sec=document.getElementById('same-room');
+      if(sec)sec.style.background=temps[idx];
     });
-  }, { threshold: 0.1 });
+  });
+
+  // ── Firefly: tap-to-catch ──
+  document.addEventListener('touchend',function(e){
+    var ff=document.getElementById('firefly');
+    if(!ff||!ff.classList.contains('alive'))return;
+    var t=e.changedTouches[0];
+    var ffRect=ff.getBoundingClientRect();
+    var ffCx=ffRect.left+ffRect.width/2;
+    var ffCy=ffRect.top+ffRect.height/2;
+    var dx=t.clientX-ffCx,dy=t.clientY-ffCy;
+    var dist=Math.sqrt(dx*dx+dy*dy);
+    if(dist<45){
+      // Simulate cursor position for the collision detection
+      window.mx=t.clientX;window.my=t.clientY;
+    }
+  },{passive:true});
 
-  document.querySelectorAll('.fade-in').forEach(function(el) {
-    observer.observe(el);
+  // ── Firefly: scroll-based idle (replaces mousemove idle) ──
+  var lastScrollTime=Date.now();
+  window.addEventListener('scroll',function(){lastScrollTime=Date.now()},{passive:true});
+  // Patch: override idle detection for touch devices
+  window._touchIdleCheck=function(){return Date.now()-lastScrollTime>5000};
+
+  // ── Firefly: hide when scrolled deep ──
+  var ff=document.getElementById('firefly');
+  window.addEventListener('scroll',function(){
+    if(!ff)return;
+    if(window.scrollY>window.innerHeight*1.5){
+      if(ff.style.opacity!=='0')ff.style.opacity='0';
+    } else {
+      if(ff.classList.contains('alive')&&ff.style.opacity==='0')ff.style.opacity='';
+    }
+  },{passive:true});
+
+  // ── K giggle: trigger on tap ──
+  document.querySelectorAll('.wm,.nav-wm').forEach(function(w){
+    w.addEventListener('click',function(){if(typeof playGiggle==='function')setTimeout(playGiggle,100)});
   });
+
+  // ── Update sr-instruction text ──
+  var inst=document.querySelector('.sr-instruction');
+  if(inst)inst.textContent='Tap each child';
 })();
 </script>
 </body>
