-  position:relative;z-index:3;flex:1 1 auto;
-  width:100%;
-  height:100%;
-  /* THE GRID. 12 columns across the stage, outer margin = the nav wordmark's
-     column (components/nav.js: 40px, 24 at 1100, 20 at 768), mirrored exactly
-     on the right.
