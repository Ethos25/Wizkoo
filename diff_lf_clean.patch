+  width: 50%;
+  position: relative;
+  overflow: hidden;
+}
+
+/* The Vignette Overlay */
+.split-vignette {
+  position: absolute;
+  top: 0; left: 0; right: 0; bottom: 0;
+  box-shadow: inset 0 0 150px rgba(12,16,32,0.9), inset 0 0 50px rgba(0,0,0,0.5);
+  z-index: 2;
+  pointer-events: none;
+}
+
+/* The Image with Cinematic Treatments */
+.split-image {
+  position: absolute;
+  top: 0; left: 0; right: 0; bottom: 0;
+  background-image: url('images/elite_table_v4.jpg');
+  background-size: cover;
+  background-position: center;
+  z-index: 1;
+  /* The Focus Pull (Starts blurred) */
+  filter: blur(15px) saturate(0.8);
+  transform: scale(1.1); /* Start slightly zoomed in */
+  transition: filter 2s cubic-bezier(0.2, 0.8, 0.2, 1), transform 2s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+
+/* When the section scrolls into view (.reveal gets .active in wz-events.js) */
+.split-section.visible .split-image {
+  /* Snap to focus */
+  filter: blur(0px) saturate(1.1);
+  /* Trigger the infinite Ken Burns breath */
+  animation: kenBurnsBreath 60s alternate infinite linear forwards;
+}
+
